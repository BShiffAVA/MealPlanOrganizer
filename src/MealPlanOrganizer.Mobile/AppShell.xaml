<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MealPlanOrganizer.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MealPlanOrganizer.Mobile"
    Title="MealPlanOrganizer.Mobile">

    <!-- Use unique route names for tabs to avoid conflicts with Routing.RegisterRoute -->
    <ShellContent
        x:Name="HomeShellContent"
        Title="Home"
        Route="HomeTab" />

    <ShellContent
        x:Name="MealPlansShellContent"
        Title="Meal Plans"
        Route="MealPlansTab" />

    <ShellContent
        Title="Add Recipe"
        ContentTemplate="{DataTemplate local:AddRecipePage}"
        Route="AddRecipeTab" />

    <ShellContent
        Title="Import Recipe"
        ContentTemplate="{DataTemplate local:ExtractRecipePage}"
        Route="ImportRecipeTab" />

    <!-- Logout Menu Item -->
    <MenuItem 
        Text="Sign Out"
        Clicked="OnLogoutClicked" />

</Shell>
