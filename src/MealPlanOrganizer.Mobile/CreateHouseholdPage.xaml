<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MealPlanOrganizer.Mobile.ViewModels"
             xmlns:converters="clr-namespace:MealPlanOrganizer.Mobile.Converters"
             x:Class="MealPlanOrganizer.Mobile.CreateHouseholdPage"
             x:DataType="viewmodels:CreateHouseholdViewModel"
             Title="Create Your Household"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1C1C1E}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="*,Auto,*" Padding="24">
            
            <!-- Welcome Section -->
            <VerticalStackLayout 
                Grid.Row="0"
                VerticalOptions="End"
                Spacing="8"
                Padding="0,0,0,32">
                
                <Label 
                    Text="🏠"
                    FontSize="64"
                    HorizontalOptions="Center" />
                
                <Label 
                    Text="{Binding UserDisplayName, StringFormat='Welcome, {0}!'}"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />
                
                <Label 
                    Text="Let's set up your household to start organizing meals together."
                    FontSize="16"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                
                <Label 
                    Text="Or join an existing household with an invite code."
                    FontSize="14"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" />
            </VerticalStackLayout>

            <!-- Form Section -->
            <VerticalStackLayout 
                Grid.Row="1"
                Spacing="16"
                MaximumWidthRequest="400">

                <!-- Error Message -->
                <Border 
                    IsVisible="{Binding IsErrorVisible}"
                    BackgroundColor="#FFEBEE"
                    Stroke="#EF5350"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">
                    <Label 
                        Text="{Binding ErrorMessage}"
                        TextColor="#C62828"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />
                </Border>

                <!-- Household Name Input -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                        Text="Household Name"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}" />
                    <Entry 
                        Text="{Binding HouseholdName}"
                        Placeholder="e.g., The Smith Family"
                        PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#666666}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}"
                        TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                        FontSize="16"
                        HeightRequest="50"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label 
                        Text="This name will be visible to all family members you invite."
                        FontSize="12"
                        TextColor="{AppThemeBinding Light=#999999, Dark=#888888}" />
                </VerticalStackLayout>

                <!-- Create Button -->
                <Button 
                    Text="Create Household"
                    Command="{Binding CreateHouseholdCommand}"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#6C63FF"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8"
                    Margin="0,8,0,0" />

                <!-- Or Divider -->
                <Grid 
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center" 
                             Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" />
                    <Label Grid.Column="1" Text="or" FontSize="14" Padding="16,0" 
                           TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                    <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" 
                             Color="{AppThemeBinding Light=#DDDDDD, Dark=#444444}" />
                </Grid>

                <!-- Join with Invite Code Button -->
                <Button 
                    Text="Join with Invite Code"
                    Command="{Binding JoinWithInviteCodeCommand}"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="Transparent"
                    BorderColor="#6C63FF"
                    BorderWidth="2"
                    TextColor="#6C63FF"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8" />

                <!-- Loading Indicator -->
                <Grid IsVisible="{Binding IsLoading}">
                    <ActivityIndicator 
                        IsRunning="{Binding IsLoading}"
                        Color="#6C63FF"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Center" />
                    <Label 
                        Text="Creating household..."
                        FontSize="14"
                        TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                        HorizontalOptions="Center"
                        Margin="0,50,0,0" />
                </Grid>

            </VerticalStackLayout>

            <!-- Footer Section -->
            <VerticalStackLayout 
                Grid.Row="2"
                VerticalOptions="End"
                Spacing="16"
                Padding="0,32,0,16">
                
                <Label 
                    Text="Wrong account?"
                    FontSize="14"
                    HorizontalOptions="Center"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                
                <Button 
                    Text="Sign Out"
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#6C63FF"
                    FontSize="14"
                    HeightRequest="40"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
