<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MealPlanOrganizer.Mobile.ViewModels"
             xmlns:converters="clr-namespace:MealPlanOrganizer.Mobile.Converters"
             x:Class="MealPlanOrganizer.Mobile.ExtractRecipePage"
             x:DataType="vm:ExtractRecipeViewModel"
             Title="Import Recipe">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Import Recipe with AI"
                       Style="{StaticResource Headline}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Extract recipe details from a photo, URL, or text"
                       Style="{StaticResource SubHeadline}"
                       TextColor="#666666" />
            </VerticalStackLayout>

            <!-- Input Type Selector -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="📷 Photo"
                        Command="{Binding SelectImageModeCommand}"
                        BackgroundColor="{Binding ImageModeBackgroundColor}"
                        TextColor="{Binding ImageModeTextColor}"
                        CornerRadius="8" />
                <Button Grid.Column="1"
                        Text="🔗 URL"
                        Command="{Binding SelectUrlModeCommand}"
                        BackgroundColor="{Binding UrlModeBackgroundColor}"
                        TextColor="{Binding UrlModeTextColor}"
                        CornerRadius="8" />
                <Button Grid.Column="2"
                        Text="📝 Text"
                        Command="{Binding SelectTextModeCommand}"
                        BackgroundColor="{Binding TextModeBackgroundColor}"
                        TextColor="{Binding TextModeTextColor}"
                        CornerRadius="8" />
            </Grid>

            <!-- Image Input Section -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsImageMode}">
                <Label Text="Take a photo or select from gallery"
                       FontSize="14"
                       TextColor="#666666" />
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="📷 Take Photo"
                            Command="{Binding TakePhotoCommand}"
                            BackgroundColor="#6C63FF"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="8" />
                    <Button Grid.Column="1"
                            Text="🖼️ Gallery"
                            Command="{Binding PickPhotoCommand}"
                            BackgroundColor="#6C63FF"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="8" />
                </Grid>

                <!-- Selected Image Preview -->
                <Frame IsVisible="{Binding HasSelectedImage}"
                       Padding="8"
                       CornerRadius="12"
                       BorderColor="#E0E0E0"
                       HasShadow="False">
                    <Grid RowDefinitions="Auto,Auto">
                        <Image Source="{Binding SelectedImagePreview}"
                               HeightRequest="200"
                               Aspect="AspectFit" />
                        <Button Grid.Row="1"
                                Text="✕ Remove"
                                Command="{Binding ClearImageCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#FF5252"
                                FontSize="12"
                                Margin="0,8,0,0" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <!-- URL Input Section -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsUrlMode}">
                <Label Text="Enter the URL of a recipe webpage"
                       FontSize="14"
                       TextColor="#666666" />
                <Entry Text="{Binding UrlText}"
                       Placeholder="https://example.com/recipe/..."
                       PlaceholderColor="#999999"
                       Keyboard="Url" />
                <Label Text="Supports most recipe websites"
                       FontSize="12"
                       TextColor="#999999" />
            </VerticalStackLayout>

            <!-- Text Input Section -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsTextMode}">
                <Label Text="Paste or type recipe content"
                       FontSize="14"
                       TextColor="#666666" />
                <Editor Text="{Binding PastedText}"
                        Placeholder="Paste the full recipe here including ingredients and instructions..."
                        PlaceholderColor="#999999"
                        HeightRequest="200" />
                <Label Text="{Binding CharacterCountText}"
                       FontSize="12"
                       TextColor="{Binding CharacterCountColor}" />
            </VerticalStackLayout>

            <!-- Error Message -->
            <Frame IsVisible="{Binding HasError}"
                   Padding="12"
                   BackgroundColor="#FFEBEE"
                   BorderColor="#EF5350"
                   CornerRadius="8"
                   HasShadow="False">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#C62828"
                       FontSize="14" />
            </Frame>

            <!-- Extract Button -->
            <Button Text="🪄 Extract Recipe"
                    Command="{Binding ExtractCommand}"
                    BackgroundColor="{Binding ExtractButtonBackgroundColor}"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    FontSize="16"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Loading Indicator -->
            <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                 Spacing="12"
                                 HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True"
                                   Color="#4CAF50"
                                   HeightRequest="40"
                                   WidthRequest="40" />
                <Label Text="Analyzing recipe..."
                       HorizontalOptions="Center"
                       FontSize="14"
                       TextColor="#666666" />
                <Label Text="This may take a few seconds"
                       HorizontalOptions="Center"
                       FontSize="12"
                       TextColor="#999999" />
            </VerticalStackLayout>

            <!-- Tips Section -->
            <Frame Padding="12"
                   BackgroundColor="#E3F2FD"
                   BorderColor="#2196F3"
                   CornerRadius="8"
                   HasShadow="False"
                   Margin="0,8,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💡 Tips for best results:"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="#1565C0" />
                    <Label Text="• Use clear, well-lit photos"
                           FontSize="12"
                           TextColor="#1565C0" />
                    <Label Text="• Include the full recipe in the image or text"
                           FontSize="12"
                           TextColor="#1565C0" />
                    <Label Text="• URLs work best with structured recipe sites"
                           FontSize="12"
                           TextColor="#1565C0" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
