<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MealPlanOrganizer.Mobile.Models"
             x:Class="MealPlanOrganizer.Mobile.MainPage"
             Title="Meal Plan Organizer">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">
        <HorizontalStackLayout Spacing="12" HorizontalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                <Label
                    Text="Recipes"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Family favorites and recent additions"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2" />
            </VerticalStackLayout>
            <Button
                Text="📷 Import"
                Command="{Binding ImportRecipeCommand}"
                BackgroundColor="#6C63FF"
                TextColor="White"
                VerticalOptions="End"
                Padding="12,8"
                CornerRadius="8" />
            <Button
                Text="+ Add"
                Command="{Binding AddRecipeCommand}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                VerticalOptions="End"
                Padding="16,8"
                CornerRadius="8" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <SearchBar Placeholder="Search recipes"
                       Text="{Binding SearchText, Mode=TwoWay}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Picker Title="Cuisine"
                        Grid.Row="0"
                        Grid.Column="0"
                        ItemsSource="{Binding CuisineOptions}"
                        SelectedItem="{Binding SelectedCuisine, Mode=TwoWay}" />
                <Picker Title="Prep Time"
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemsSource="{Binding PrepTimeOptions}"
                        SelectedItem="{Binding SelectedPrepTime, Mode=TwoWay}" />
                <Picker Title="Rating"
                        Grid.Row="1"
                        Grid.Column="0"
                        ItemsSource="{Binding RatingOptions}"
                        SelectedItem="{Binding SelectedRating, Mode=TwoWay}" />
                <Picker Title="Creator"
                        Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{Binding CreatorOptions}"
                        SelectedItem="{Binding SelectedCreator, Mode=TwoWay}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Recipes}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RecipeCard">
                    <Frame
                        Margin="0,0,0,12"
                        Padding="12"
                        CornerRadius="12"
                        BorderColor="#E0E0E0"
                        HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewRecipeCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="{Binding Title}"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding CuisineType}" FontSize="14" TextColor="#666666" />
                                <Label Text="•" FontSize="14" TextColor="#666666" />
                                <Label Text="{Binding PrepTimeDisplay}" FontSize="14" TextColor="#666666" />
                                <Label Text="•" FontSize="14" TextColor="#666666" />
                                <Label Text="{Binding RatingDisplay}" FontSize="14" TextColor="#666666" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
