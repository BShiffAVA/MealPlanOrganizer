<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MealPlanOrganizer.Mobile"
             xmlns:converters="clr-namespace:MealPlanOrganizer.Mobile.Converters"
             xmlns:viewmodels="clr-namespace:MealPlanOrganizer.Mobile.ViewModels"
             x:Class="MealPlanOrganizer.Mobile.RecipeDetailPage"
             x:DataType="viewmodels:RecipeDetailViewModel"
             Title="Recipe Details">
    <ContentPage.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <converters:InvertedBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">
            
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                             IsVisible="{Binding IsLoading}"
                             Color="{StaticResource Primary}"
                             HeightRequest="50"/>
            
            <!-- Content Container (hidden while loading) -->
            <VerticalStackLayout IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" Spacing="20">
                
                  <!-- Recipe Image -->
                  <Frame Padding="0"
                      CornerRadius="12"
                      HasShadow="False"
                      IsVisible="{Binding HasImage}"
                      BorderColor="{StaticResource Gray600}">
                      <Image Source="{Binding ImageUrl}"
                          Aspect="AspectFill"
                          HeightRequest="200" />
                  </Frame>

                <!-- Header -->
                <Frame BackgroundColor="{StaticResource Primary}" 
                       Padding="20" 
                       CornerRadius="10"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Title}" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White"/>
                        <HorizontalStackLayout Spacing="15">
                            <Label Text="{Binding CuisineType}" 
                                   FontSize="14" 
                                   TextColor="White" 
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding RatingDisplay}" 
                                   FontSize="14" 
                                   TextColor="White" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsCurrentUserCreator}">
                    <Button Text="Edit Recipe"
                            Command="{Binding EditCommand}"
                            BackgroundColor="#FF9800"
                            TextColor="White" />
                </HorizontalStackLayout>

                <!-- Description -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Description" 
                           FontSize="18" 
                           FontAttributes="Bold"/>
                    <Label Text="{Binding Description}" 
                           FontSize="14" 
                           TextColor="{StaticResource Gray600}"/>
                </VerticalStackLayout>

                <!-- Recipe Info -->
                <Frame BorderColor="{StaticResource Gray200}" 
                       BackgroundColor="#1A1A1A" 
                       Padding="15" 
                       CornerRadius="10">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                            <Label Text="Prep Time" FontSize="12" TextColor="{StaticResource Gray400}"/>
                            <Label Text="{Binding PrepTime}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                            <Label Text="Cook Time" FontSize="12" TextColor="{StaticResource Gray400}"/>
                            <Label Text="{Binding CookTime}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="5">
                            <Label Text="Servings" FontSize="12" TextColor="{StaticResource Gray400}"/>
                            <Label Text="{Binding Servings}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="5">
                            <Label Text="Created By" FontSize="12" TextColor="{StaticResource Gray400}"/>
                            <Label Text="{Binding CreatorDisplay}" FontSize="14" TextColor="White"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Ratings Summary -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ratings" 
                           FontSize="20" 
                           FontAttributes="Bold"/>
                    
                    <!-- Star Breakdown -->
                    <Frame BorderColor="{StaticResource Gray600}" 
                           BackgroundColor="#1A1A1A" 
                           Padding="12" 
                           CornerRadius="8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding AvgRatingDisplay}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="White"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Text="5★" TextColor="White" FontSize="12"/>
                                <ProgressBar Grid.Row="0" Grid.Column="1" Progress="{Binding Star5Progress}" ProgressColor="{StaticResource Primary}" Margin="8,0"/>
                                <Label Grid.Row="0" Grid.Column="2" Text="{Binding Star5Count}" TextColor="White" FontSize="12"/>
                                
                                <Label Grid.Row="1" Grid.Column="0" Text="4★" TextColor="White" FontSize="12"/>
                                <ProgressBar Grid.Row="1" Grid.Column="1" Progress="{Binding Star4Progress}" ProgressColor="{StaticResource Primary}" Margin="8,0"/>
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Star4Count}" TextColor="White" FontSize="12"/>
                                
                                <Label Grid.Row="2" Grid.Column="0" Text="3★" TextColor="White" FontSize="12"/>
                                <ProgressBar Grid.Row="2" Grid.Column="1" Progress="{Binding Star3Progress}" ProgressColor="{StaticResource Primary}" Margin="8,0"/>
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding Star3Count}" TextColor="White" FontSize="12"/>
                                
                                <Label Grid.Row="3" Grid.Column="0" Text="2★" TextColor="White" FontSize="12"/>
                                <ProgressBar Grid.Row="3" Grid.Column="1" Progress="{Binding Star2Progress}" ProgressColor="{StaticResource Primary}" Margin="8,0"/>
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding Star2Count}" TextColor="White" FontSize="12"/>
                                
                                <Label Grid.Row="4" Grid.Column="0" Text="1★" TextColor="White" FontSize="12"/>
                                <ProgressBar Grid.Row="4" Grid.Column="1" Progress="{Binding Star1Progress}" ProgressColor="{StaticResource Primary}" Margin="8,0"/>
                                <Label Grid.Row="4" Grid.Column="2" Text="{Binding Star1Count}" TextColor="White" FontSize="12"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- User's Personal Rating -->
                    <Frame BorderColor="{StaticResource Primary}" 
                           BackgroundColor="#2A2A2A" 
                           Padding="12" 
                           CornerRadius="8"
                           IsVisible="{Binding HasUserRating}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Your Most Recent Rating" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding UserRatingStars}" FontSize="16" TextColor="White"/>
                                <Label Text="{Binding UserRatingDate}" FontSize="12" TextColor="{StaticResource Gray400}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding UserNextTimePreference}" FontSize="12" TextColor="{StaticResource Gray400}" IsVisible="{Binding HasUserNextTimePreference}"/>
                            <Label Text="{Binding UserRatingComments}" FontSize="13" TextColor="White" LineBreakMode="WordWrap" IsVisible="{Binding HasUserRatingComments}"/>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Rate This Recipe Section -->
                    <Frame BorderColor="{StaticResource Primary}" 
                           BackgroundColor="#1A1A1A" 
                           Padding="16" 
                           CornerRadius="10">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Rate This Recipe" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="White"/>
                            
                            <!-- Star Rating Buttons -->
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Button Text="1★" Command="{Binding SelectRatingCommand}" CommandParameter="{x:Int32 1}"
                                        WidthRequest="50" HeightRequest="44" 
                                        BackgroundColor="{Binding Star1Color}" TextColor="White"/>
                                <Button Text="2★" Command="{Binding SelectRatingCommand}" CommandParameter="{x:Int32 2}"
                                        WidthRequest="50" HeightRequest="44" 
                                        BackgroundColor="{Binding Star2Color}" TextColor="White"/>
                                <Button Text="3★" Command="{Binding SelectRatingCommand}" CommandParameter="{x:Int32 3}"
                                        WidthRequest="50" HeightRequest="44" 
                                        BackgroundColor="{Binding Star3Color}" TextColor="White"/>
                                <Button Text="4★" Command="{Binding SelectRatingCommand}" CommandParameter="{x:Int32 4}"
                                        WidthRequest="50" HeightRequest="44" 
                                        BackgroundColor="{Binding Star4Color}" TextColor="White"/>
                                <Button Text="5★" Command="{Binding SelectRatingCommand}" CommandParameter="{x:Int32 5}"
                                        WidthRequest="50" HeightRequest="44" 
                                        BackgroundColor="{Binding Star5Color}" TextColor="White"/>
                            </HorizontalStackLayout>
                            
                            <!-- Selected Rating Display -->
                            <Label Text="{Binding SelectedRatingText}" 
                                   FontSize="14" 
                                   TextColor="{Binding SelectedRatingTextColor}" 
                                   HorizontalOptions="Center"/>
                            
                            <!-- Frequency Preference Picker -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="When would you next like to eat this meal?" 
                                    FontSize="14" 
                                    TextColor="{StaticResource Gray400}"/>
                                <Picker Title="Select next time (optional)"
                                     ItemsSource="{Binding NextTimePreferenceOptions}"
                                     SelectedItem="{Binding SelectedNextTimePreference}"
                                     TextColor="White"
                                     TitleColor="{StaticResource Gray400}"/>
                            </VerticalStackLayout>
                            
                            <!-- Comments Entry -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Comments (optional)" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray400}"/>
                                <Editor Text="{Binding Comments}"
                                        Placeholder="Share your thoughts about this recipe..." 
                                        PlaceholderColor="{StaticResource Gray600}"
                                        TextColor="White"
                                        BackgroundColor="#2A2A2A"
                                        HeightRequest="80"
                                        MaxLength="500"/>
                                <Label Text="{Binding CommentsLength, StringFormat='{0}/500'}" 
                                       FontSize="11" 
                                       TextColor="{StaticResource Gray600}" 
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                            
                            <!-- Submit Button -->
                            <Button Text="{Binding SubmitButtonText}" 
                                    Command="{Binding SubmitRatingCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    IsEnabled="{Binding CanSubmitRating}"/>
                            
                            <!-- Rating Status Message -->
                            <Label Text="{Binding RatingStatusMessage}" 
                                   FontSize="13" 
                                   TextColor="{Binding RatingStatusColor}" 
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding ShowRatingStatus}"/>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- All Ratings List -->
                    <Label Text="All Ratings" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <CollectionView ItemsSource="{Binding Ratings}">
                        <CollectionView.EmptyView>
                            <Label Text="No ratings yet" 
                                   TextColor="White" 
                                   FontSize="14"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecipeRatingDto">
                                <Frame BorderColor="{StaticResource Gray600}" 
                                       BackgroundColor="#1A1A1A"
                                       Padding="12" 
                                       Margin="0,4" 
                                       CornerRadius="8">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Rating}" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold" 
                                                   TextColor="White"/>
                                            <Label Text="★" FontSize="14" TextColor="White"/>
                                            <Label Text="{Binding UserId}" 
                                                   FontSize="13" 
                                                   TextColor="White"/>
                                            <Label Text="•" FontSize="13" TextColor="White"/>
                                            <Label Text="{Binding RatedUtc, StringFormat='{0:MMM d, yyyy}'}" 
                                                   FontSize="13" 
                                                   TextColor="White"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding FrequencyDisplay}" 
                                               FontSize="12" 
                                               TextColor="{StaticResource Gray400}"
                                               IsVisible="{Binding FrequencyPreference, Converter={StaticResource StringNotEmptyConverter}}"/>
                                        <Label Text="{Binding Comments}" 
                                               FontSize="14" 
                                               TextColor="White"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Ingredients -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ingredients" 
                           FontSize="20" 
                           FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding Ingredients}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecipeIngredientDto">
                                <Frame BorderColor="{StaticResource Gray600}" 
                                       BackgroundColor="#1A1A1A"
                                       Padding="12" 
                                       Margin="0,2" 
                                       CornerRadius="8">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="•" FontSize="16" VerticalOptions="Center" TextColor="White"/>
                                        <Label FontSize="15" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Quantity}" FontAttributes="Bold" TextColor="White"/>
                                                    <Span Text=" " TextColor="White"/>
                                                    <Span Text="{Binding Name}" TextColor="White"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Instructions -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Instructions" 
                           FontSize="20" 
                           FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding Steps}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecipeStepDto">
                                <Frame BorderColor="{StaticResource Primary}" 
                                       Padding="15" 
                                       Margin="0,5" 
                                       CornerRadius="10"
                                       BackgroundColor="#1A1A1A">
                                    <HorizontalStackLayout Spacing="15" VerticalOptions="Start">
                                        <Frame BackgroundColor="{StaticResource Primary}" 
                                               Padding="10" 
                                               CornerRadius="20" 
                                               WidthRequest="40" 
                                               HeightRequest="40"
                                               HasShadow="False">
                                            <Label Text="{Binding StepNumber}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="White" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Frame>
                                        <Label Text="{Binding Instruction}" 
                                               FontSize="15" 
                                               VerticalOptions="StartAndExpand" 
                                               LineBreakMode="WordWrap"
                                               TextColor="White"
                                               HorizontalOptions="FillAndExpand"/>
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
